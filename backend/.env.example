# Database Configuration
# For Local Development:
DATABASE_URL="postgresql://user:password@localhost:5432/adultmixer?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/adultmixer?schema=public"

# For Neon (cloud): use pooled URL for DATABASE_URL and direct URL for DIRECT_URL.
# Neon free tier suspends the database after ~5 min of inactivity — add timeouts so wake-up can finish:
# DATABASE_URL="postgresql://...@...-pooler.../neondb?sslmode=require&pgbouncer=true&connection_limit=10&connect_timeout=30&pool_timeout=30"
# DIRECT_URL="postgresql://...@....neon.tech/neondb?sslmode=require&connect_timeout=30"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Frontend URL(s) for CORS and Stripe redirect URLs (comma-separated, no trailing slash)
# Local: http://localhost:5173
# Production: https://adult-mixer-calgary.vercel.app,https://adultmixer.ca,https://www.adultmixer.ca
# Note: https://*.vercel.app is also allowed automatically by backend CORS
FRONTEND_URL="http://localhost:5173"

# Email (Resend)
RESEND_API_KEY="re_your_api_key_here"
CONTACT_EMAIL="support@adultmixercalgary.com"

NODE_ENV="development"
PORT=5001

# Stripe (test/sandbox mode — use sk_test_ keys only during development)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRICE_ID_STARTER_MONTHLY="price_starter_monthly"
STRIPE_PRICE_ID_STARTER_YEARLY="price_starter_yearly"
STRIPE_PRICE_ID_PREMIUM_MONTHLY="price_premium_monthly"
STRIPE_PRICE_ID_PREMIUM_YEARLY="price_premium_yearly"
STRIPE_PRICE_ID_ELITE_MONTHLY="price_elite_monthly"
STRIPE_PRICE_ID_ELITE_YEARLY="price_elite_yearly"
