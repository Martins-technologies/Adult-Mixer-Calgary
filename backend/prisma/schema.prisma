generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  role               Role                @default(USER)
  emailVerified      Boolean             @default(false)
  firstName          String
  lastName           String?
  bio                String?
  birthDate          DateTime
  gender             Gender
  preference         Preference          @default(EVERYONE)
  profileImageUrl    String?
  sexualOrientation  SexualOrientation?
  relationshipStatus RelationshipStatus?
  ethnicity          Ethnicity?
  religion           Religion?
  educationLevel     EducationLevel?
  bodyType           BodyType?
  hasChildren        Boolean?
  wantsChildren      WantsChildren?
  diet               Diet?
  drinking           Frequency?
  smoking            Frequency?
  drugs              Frequency?
  pets               Pet[]
  language           String?
  city               String?             @default("Calgary")
  latitude           Float?
  longitude          Float?
  prefMinAge         Int?
  prefMaxAge         Int?
  prefEthnicity      Ethnicity?
  prefReligion       Religion?
  prefEducationLevel EducationLevel?
  prefLanguage       String?
  prefMaxDistanceKm  Int?                @default(50)
  profileCompletedAt DateTime?
  isOnline           Boolean             @default(false)
  lastSeenAt         DateTime?
  isBlocked          Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  givenLikes         Like[]              @relation("GivenLikes")
  receivedLikes      Like[]              @relation("ReceivedLikes")
  givenSkips         Skip[]              @relation("GivenSkips")
  receivedSkips      Skip[]              @relation("ReceivedSkips")
  matchesAsUser1     Match[]             @relation("MatchUser1")
  matchesAsUser2     Match[]             @relation("MatchUser2")
  sentMessages       Message[]           @relation("SentMessages")
  subscription        Subscription?
  contactMessages     ContactMessage[]
  paymentTransactions PaymentTransaction[]

  @@index([email])
  @@index([gender])
  @@index([preference])
  @@index([deletedAt])
  @@index([city])
}

model Like {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("GivenLikes", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedLikes", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Skip {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("GivenSkips", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedSkips", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Match {
  id        String    @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime  @default(now())
  user1     User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[] @relation("MatchMessages")

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  match     Match    @relation("MatchMessages", fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([senderId])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Preference {
  MALE
  FEMALE
  EVERYONE
}

enum SexualOrientation {
  STRAIGHT
  GAY
  BISEXUAL
}

enum RelationshipStatus {
  SINGLE
  DIVORCED
  WIDOWED
}

enum Ethnicity {
  WHITE
  BLACK
  ASIAN
  SOUTH_ASIAN
  HISPANIC
  MIDDLE_EASTERN
  MIXED
  OTHER
}

enum Religion {
  CHRISTIANITY
  ISLAM
  HINDUISM
  JUDAISM
  BUDDHISM
  ATHEIST
  AGNOSTIC
  OTHER
  PREFER_NOT_TO_SAY
}

enum EducationLevel {
  HIGH_SCHOOL
  SOME_COLLEGE
  UNDERGRADUATE
  POSTGRADUATE
}

enum BodyType {
  SLIM
  ATHLETIC
  AVERAGE
  CURVY
  PLUS_SIZE
}

enum Diet {
  ANYTHING
  VEGETARIAN
  VEGAN
  HALAL
  KOSHER
  OTHER
}

enum Frequency {
  NEVER
  RARELY
  SOMETIMES
  REGULARLY
}

enum WantsChildren {
  WANTS
  DOESNT_WANT
  OPEN
}

enum Pet {
  HAS_CATS
  HAS_DOGS
  OTHER
  NONE
}

enum SubscriptionPlan {
  STARTER
  PREMIUM
  ELITE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  plan                 SubscriptionPlan
  billingCycle         BillingCycle
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  cancelledAt          DateTime?
  paymentProvider      PaymentProvider?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@index([paymentProvider])
}

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  userId                String
  provider              PaymentProvider
  providerTransactionId String                   @unique
  amount                Float
  currency              String                   @default("USD")
  plan                  SubscriptionPlan
  status                PaymentTransactionStatus @default(PENDING)
  rawPayload            Json?
  createdAt             DateTime                 @default(now())
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}
